# HTTP
PORT=8788
HOST=0.0.0.0
# Comma-separated browser origins, or * for native/web clients
CORS_ORIGIN=*
TRUST_PROXY=true

# Photobooth Next.js origin. GET /api/frames and /api/events are cached.
# Leave empty to run the AI gateway without proxying the app.
UPSTREAM_ORIGIN=http://127.0.0.1:3000
UPSTREAM_TIMEOUT_MS=20000

# Connection pool
HTTP_CONNECTIONS=64
HTTP_KEEPALIVE_MS=30000

# Cache
CACHE_MAX_ENTRIES=2000
CACHE_DEFAULT_TTL_MS=30000
CACHE_FRAMES_TTL_MS=60000
CACHE_EVENTS_TTL_MS=15000
CACHE_AI_TTL_MS=600000
CACHE_SWR_MS=15000
CACHE_MAX_BODY_BYTES=1048576

# Rate limits (per IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AI_RATE_LIMIT_MAX=20

# Auth. Any one of these master keys is treated as an admin caller.
GATEWAY_API_KEY=
PIKABOOTH_API_KEY=
API_SECRET_KEY=
# Firebase web API key used to verify ID tokens (same value as the Next app).
FIREBASE_API_KEY=
ADMIN_EMAILS=

# Generative providers. Server keys stay here; the app can still pass a key.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=3
AI_TIMEOUT_MS=45000
ALLOW_CLIENT_AI_KEYS=true
# Local Ollama / LM Studio. Metadata and private-network bases stay blocked.
ALLOW_LOCAL_AI=true
