    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.3",
    "pg": "^8.23.1",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
