{
  "name": "photobooth-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone API gateway for Photobooth: cached upstream proxy and AI generative routing.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
