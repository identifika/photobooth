# env files (can opt-in for committing if needed)
.env*
!gateway/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

firebase.json
firestore.rules

# prisma client output
/lib/generated/prisma

signal-relay/

# standalone API gateway
gateway/node_modules/
gateway/dist/
ios/App/App/GoogleService-Info.plist
.code-grapher/
